{
  "mcpServers": {
    "pycodekg": {
      "command": "${HOME}/.local/bin/pycodekg",
      "args": [
        "mcp",
        "--repo",
        "."
      ],
      "env": {
        "POETRY_VIRTUALENVS_IN_PROJECT": "false"
      }
    },
    "dockg": {
      "command": "${HOME}/.local/bin/dockg-mcp",
      "args": [
        "--repo",
        "."
      ],
      "env": {
        "POETRY_VIRTUALENVS_IN_PROJECT": "false"
      }
    },
    "ftreekg": {
      "command": ".venv/bin/ftreekg-mcp",
      "args": [
        "--repo",
        "."
      ],
      "env": {
        "POETRY_VIRTUALENVS_IN_PROJECT": "false"
      }
    }
  }
}
